{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "seller",
        "buyer",
        "agent",
        "contractor",
        "other"
      ],
      "default": "buyer"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this buyer is actively looking"
    },
    "buyer_property_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred property types for buyer"
    },
    "buyer_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred cities/states/zip codes"
    },
    "buyer_min_beds": {
      "type": "number",
      "description": "Minimum bedrooms"
    },
    "buyer_max_price": {
      "type": "number",
      "description": "Maximum purchase price"
    },
    "buyer_min_arv": {
      "type": "number",
      "description": "Minimum ARV they target"
    },
    "buyer_deal_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred deal types (assignment, double_close, novation)"
    },
    "buyer_notes": {
      "type": "string",
      "description": "Additional buyer preferences"
    }
  },
  "required": [
    "name",
    "type"
  ]
}