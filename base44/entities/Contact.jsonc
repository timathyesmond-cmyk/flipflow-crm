{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "cash_buyer",
        "wholesaler",
        "agent",
        "contractor",
        "title_company",
        "seller",
        "other"
      ],
      "default": "cash_buyer"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this contact is actively looking/working"
    },
    "buyer_property_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred property types"
    },
    "buyer_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred cities/states/zip codes"
    },
    "buyer_min_beds": {
      "type": "number"
    },
    "buyer_max_price": {
      "type": "number"
    },
    "buyer_min_arv": {
      "type": "number"
    },
    "buyer_deal_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buyer_notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}