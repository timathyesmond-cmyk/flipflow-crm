{
  "name": "Deal",
  "type": "object",
  "properties": {
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "contacted",
        "under_contract",
        "assigned",
        "closed",
        "dead"
      ],
      "default": "lead",
      "description": "Current deal stage"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "assignment",
        "double_close",
        "novation"
      ],
      "default": "assignment"
    },
    "asking_price": {
      "type": "number"
    },
    "offer_price": {
      "type": "number"
    },
    "arv": {
      "type": "number"
    },
    "repair_estimate": {
      "type": "number"
    },
    "assignment_fee": {
      "type": "number"
    },
    "buyer_price": {
      "type": "number"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_phone": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "driving_for_dollars",
        "direct_mail",
        "cold_calling",
        "referral",
        "mls",
        "auction",
        "online_marketing",
        "other"
      ]
    },
    "property_type": {
      "type": "string",
      "enum": [
        "single_family",
        "multi_family",
        "townhouse",
        "condo",
        "land",
        "commercial",
        "other"
      ],
      "default": "single_family"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "sqft": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "contract_date": {
      "type": "string",
      "format": "date"
    },
    "closing_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Follow-up reminder date"
    },
    "follow_up_note": {
      "type": "string",
      "description": "Note for what to follow up on"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of uploaded property photo URLs"
    }
  },
  "required": [
    "property_address",
    "stage"
  ]
}