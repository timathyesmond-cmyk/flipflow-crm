{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "gifted_membership": {
      "type": "boolean",
      "default": false,
      "description": "If true, user has a permanently free membership \u2014 bypasses trial expiry and payment prompts"
    },
    "gifted_membership_note": {
      "type": "string",
      "description": "Admin note explaining why membership was gifted"
    },
    "gifted_membership_date": {
      "type": "string",
      "description": "Date the membership was gifted"
    },
    "trial_start_date": {
      "type": "string",
      "description": "ISO timestamp of when the 7-day trial started (set server-side only via getTrialStatus)"
    },
    "trial_ends_at": {
      "type": "string",
      "description": "ISO timestamp when the trial expires (set server-side only via getTrialStatus)"
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "ban_reason": {
      "type": "string"
    }
  }
}