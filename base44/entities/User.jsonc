{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is banned from the platform"
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason for the ban"
    }
  }
}