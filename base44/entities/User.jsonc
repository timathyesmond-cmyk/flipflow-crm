{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL to user profile photo"
    },
    "phone": {
      "type": "string",
      "description": "User phone number"
    },
    "company": {
      "type": "string",
      "description": "Company or business name"
    },
    "website": {
      "type": "string",
      "description": "Personal or business website URL"
    }
  }
}